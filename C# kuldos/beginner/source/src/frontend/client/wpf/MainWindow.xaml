<Window x:Class="MyApp.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szerverállapot – WPF" Height="500" Width="800">
    <StackPanel Margin="24">
        <Button Content="Ellenőrzés" Command="{Binding CheckConnectionCommand}"
                HorizontalAlignment="Left" />
        <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" />
    </StackPanel>
</Window>
