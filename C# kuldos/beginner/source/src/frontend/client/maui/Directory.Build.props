<Project>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <BaseIntermediateOutputPath>$(TEMP)\tc\starter-net10-$([MSBuild]::StableStringHash('$(MSBuildProjectDirectory)'))\obj\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>